{
    "name": "benedmunds/codeigniter-ion-auth",
    "description": "Simple and Lightweight Auth System for CodeIgniter",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter",
        "auth"
    ],
    "homepage": "http://benedmunds.com/ion_auth",
    "authors": [
        {
            "name": "Ben EDMUNDS"
        },
        {
            "name": "Benoit VRIGNAUD",
            "email": "benoit.vrignaud@tangue.fr"
        }
    ],
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "IonAuth\\": ""
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --fail-on-warning --fail-on-risky --fail-on-deprecation --fail-on-notice"
    }
}
